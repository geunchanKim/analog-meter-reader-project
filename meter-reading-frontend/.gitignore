# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
dist-ssr/
*.local

# --- Environment / secrets ---
# VITE_API_BASE_URL and anything else project-specific goes in .env,
# which should never be committed -- but keep .env.example tracked so
# anyone cloning the repo knows which variables they need to set.
.env
.env.*
!.env.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Test / coverage (if added later) ---
coverage/