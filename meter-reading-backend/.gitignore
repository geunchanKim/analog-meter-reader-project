# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Model weights & cached model downloads ---
# YOLO checkpoints (Stage 2) -- these are large binary files that
# belong in a model registry or cloud storage, not in git history.
*.pt
*.onnx
# PaddleOCR/PaddleX auto-downloads its sub-models into a cache dir on
# first run (PP-LCNet, UVDoc, PP-OCRv6 det/rec, etc.) -- never commit this.
.paddlex/

# --- Local data / analysis outputs ---
# precomputed_keypoints.json and similar files generated by
# analysis/precompute_keypoints.py are run-specific and can be large;
# regenerate locally rather than versioning them.
data/
*.json
!package.json
!package-lock.json

# --- Celery ---
celerybeat-schedule
celerybeat.pid
*.pid

# --- Logs ---
*.log
logs/

# --- Docker (local overrides only, not the shared compose files) ---
docker-compose.override.yml

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Jupyter (leftover exploration notebooks/checkpoints, if any end up in this repo) ---
.ipynb_checkpoints/

*.rdb